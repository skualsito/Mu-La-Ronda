# Copiar a deploy/.env en el VPS y completar. No se commitea (.env esta en .gitignore).

# Dominio base: el cliente usa play.<DOMAIN>, ws.<DOMAIN>, admin.<DOMAIN>.
# Sin dominio propio todavia: usar sslip.io con la IP del VPS con guiones,
# p.ej. 203-0-113-10.sslip.io (resuelve solo, y certbot saca HTTPS igual).
DOMAIN=203-0-113-10.sslip.io

# Email para Let's Encrypt (certbot, avisos de certificados).
ACME_EMAIL=

# Password de Postgres. Generar con: openssl rand -hex 24
DB_PASSWORD=

# Usuario inicial del panel de OpenMU (admin.<DOMAIN>). Sin esto el panel queda
# abierto a cualquiera hasta que se cree el primer usuario.
OPENMU_ADMIN_USER=admin
OPENMU_ADMIN_PASSWORD=

# Version de la imagen munique/openmu.
OPENMU_TAG=latest

# Loguear paquetes en el proxy (on/off). Util para debug en staging.
LOG_PACKETS=off

# Puertos internos (solo 127.0.0.1). Wings de Pterodactyl usa 8080 y 2022.
PROXY_PORT=3000
PRESENCE_PORT=3001
ADMIN_PORT=8090
REGISTER_PORT=3100
DB_PORT=5432

# Cuentas que se pueden crear por IP cada 24 h desde register.<DOMAIN>.
REGISTER_RATE_LIMIT=3
