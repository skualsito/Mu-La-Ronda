# Mu La Ronda - sitios para el nginx del host (convive con el de Pterodactyl).
# Lo instala deploy/setup-nginx.sh reemplazando ${DOMAIN}, ${APP_DIR},
# ${PROXY_PORT}, ${ADMIN_PORT}, ${ADMIN_PANEL_PORT}, ${REGISTER_PORT} y ${MARKETPLACE_PORT};
# despues certbot le agrega el HTTPS.

map $http_upgrade $mu_connection_upgrade {
    default upgrade;
    ''      close;
}

# play.<DOMAIN> es el nombre que usa la convencion del cliente; el juego vive
# en el dominio principal, asi que redirige ahi.
server {
    listen 80;
    listen [::]:80;
    server_name play.${DOMAIN};
    return 301 https://${DOMAIN}$request_uri;
}

# Cliente web, en el dominio principal. SPA (/online, /offline): rutas
# desconocidas -> index.html.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    root ${APP_DIR}/dist;
    index index.html;

    # Los .gz los genera `bun run build` (compress-assets).
    gzip_static on;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /index.html     { add_header Cache-Control "no-cache"; }
    location = /serverlist.md  { add_header Cache-Control "no-cache"; default_type text/plain; }
    location = /sw.js          { add_header Cache-Control "no-cache"; }

    # El registro (register.<DOMAIN>, mas adelante) toma sprites de Data/.
    location /Data/ {
        add_header Access-Control-Allow-Origin "*";
        try_files $uri =404;
    }

    # Mercado (servicio marketplace). El cliente lo llama relativo porque el
    # juego se sirve desde este mismo dominio.
    location /api/market/ {
        proxy_pass http://127.0.0.1:${MARKETPLACE_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 16k;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# Puente WebSocket -> TCP hacia OpenMU.
server {
    listen 80;
    listen [::]:80;
    server_name ws.${DOMAIN};

    location / {
        proxy_pass http://127.0.0.1:${PROXY_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $mu_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}

# Pagina de registro (dist-register/) y su API. El cliente tambien postea aca
# desde play.<DOMAIN> (CORS_ORIGIN del servicio).
server {
    listen 80;
    listen [::]:80;
    server_name register.${DOMAIN};

    root ${APP_DIR}/dist-register;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:${REGISTER_PORT};
        proxy_set_header Host $host;
        # El servicio limita cuentas por IP y toma el ultimo salto de este header.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 4k;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# Panel de administracion de Mu La Ronda (admin/): la pagina (dist-admin/) y su API.
server {
    listen 80;
    listen [::]:80;
    server_name admin.${DOMAIN};

    root ${APP_DIR}/dist-admin;
    index index.html;

    # Que ningun buscador lo indexe.
    add_header X-Robots-Tag "noindex, nofollow" always;

    location /api/ {
        proxy_pass http://127.0.0.1:${ADMIN_PANEL_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 64k;
    }

    location = /index.html { add_header Cache-Control "no-cache"; }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# Panel propio de OpenMU (Blazor: necesita WebSocket tambien), para lo que el
# de Mu La Ronda no cubre. Usuario/clave: OPENMU_ADMIN_USER/PASSWORD del .env.
server {
    listen 80;
    listen [::]:80;
    server_name openmu.${DOMAIN};

    location / {
        proxy_pass http://127.0.0.1:${ADMIN_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $mu_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
    }
}
